# Copy these into your Node host's environment variables (do not commit secrets).
PORT=3000
DB_PATH=./server/data/devshow.sqlite
# Exact HTTPS origin(s) of the GitHub Pages frontend, separated by commas:
CORS_ORIGINS=https://sillydev2026.github.io,http://localhost:3000
# Optional server-side GitHub API token for higher rate limits (never expose in config.js):
# GITHUB_TOKEN=github_pat_your_server_side_token
# Public deployments: CORS_ORIGINS=https://sillydev2026.github.io
