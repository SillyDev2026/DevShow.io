{
  "name": "devshow-io",
  "version": "2.5.1",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13.0"},
  "description": "DevShow — open-source developer community with Node.js, SQLite and GitHub Pages frontend",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js && node tests/smoke.mjs",
